---
import type { Photo } from "../types/album";

interface Props {
  photos: Photo[];
  albumId?: string;
}

const { photos, albumId } = Astro.props;

// Transform photos to include necessary fields for Alpine
const photosData = photos.map((photo, index) => ({
  alt: photo.title || photo.filename,
  caption: photo.caption,
  exif: photo.exif,
  filename: photo.filename,
  id: `${albumId || "photo"}-${index}`,
  src: photo.url,
  tags: photo.tags,
  thumbnailSrc: photo.thumbnailUrl,
  title: photo.title,
}));
---

<div
  x-data="{
    photos: [],
    selectedPhoto: null,
    lightboxOpen: false,
    selectedTag: 'all',
    availableTags: [],
    scrollDirection: 'down',
    lastScrollY: 0,

    init() {
      this.photos = JSON.parse(this.$el.dataset.photos);
      this.availableTags = this.extractTags();
      this.setupScrollTracking();
    },

    setupScrollTracking() {
      let scrollTimeout;
      window.addEventListener('scroll', () => {
        const currentScrollY = window.scrollY;
        this.scrollDirection = currentScrollY > this.lastScrollY ? 'down' : 'up';
        this.lastScrollY = currentScrollY;

        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          this.prefetchNearbyImages();
        }, 150);
      }, { passive: true });
    },

    loadImage(img, photoId, thumbnailSrc) {
      if (!img.dataset.loaded) {
        img.src = thumbnailSrc;
        img.dataset.loaded = 'true';

        // Prefetch nearby images after loading
        setTimeout(() => this.prefetchNearbyImages(), 50);
      }
    },

    prefetchNearbyImages() {
      // Prefetch images near the viewport
      const images = this.$el.querySelectorAll('img[data-photo-id]:not([data-loaded])');
      images.forEach(img => {
        const rect = img.getBoundingClientRect();
        const margin = this.scrollDirection === 'down' ? 600 : 400;
        const isNearViewport = rect.top < window.innerHeight + margin && rect.bottom > -200;

        if (isNearViewport && img.dataset.src) {
          img.src = img.dataset.src;
          img.dataset.loaded = 'true';
        }
      });
    },

    extractTags() {
      const tags = new Set(['all']);
      this.photos.forEach(photo => {
        if (photo.tags) {
          photo.tags.forEach(tag => tags.add(tag));
        }
      });
      return Array.from(tags);
    },

    get filteredPhotos() {
      const filtered = this.selectedTag === 'all'
        ? this.photos
        : this.photos.filter(photo => photo.tags && photo.tags.includes(this.selectedTag));

      // Trigger image loading after filter changes
      this.$nextTick(() => this.prefetchNearbyImages());

      return filtered;
    },

    openLightbox(photo) {
      this.selectedPhoto = photo;
      this.lightboxOpen = true;
      // Preload full-size image when lightbox opens
      const fullImg = new Image();
      fullImg.src = photo.src;
    },

    closeLightbox() {
      this.lightboxOpen = false;
      setTimeout(() => this.selectedPhoto = null, 300);
    },

    nextPhoto() {
      const currentIndex = this.filteredPhotos.findIndex(p => p.id === this.selectedPhoto.id);
      const nextIndex = (currentIndex + 1) % this.filteredPhotos.length;
      this.selectedPhoto = this.filteredPhotos[nextIndex];
      // Preload next photo's full size
      const nextNextIndex = (nextIndex + 1) % this.filteredPhotos.length;
      const preloadImg = new Image();
      preloadImg.src = this.filteredPhotos[nextNextIndex].src;
    },

    prevPhoto() {
      const currentIndex = this.filteredPhotos.findIndex(p => p.id === this.selectedPhoto.id);
      const prevIndex = (currentIndex - 1 + this.filteredPhotos.length) % this.filteredPhotos.length;
      this.selectedPhoto = this.filteredPhotos[prevIndex];
      // Preload previous photo's full size
      const prevPrevIndex = (prevIndex - 1 + this.filteredPhotos.length) % this.filteredPhotos.length;
      const preloadImg = new Image();
      preloadImg.src = this.filteredPhotos[prevPrevIndex].src;
    }
  }"
  data-photos={JSON.stringify(photosData)}
  class="w-full"
>
  <!-- Tag Filter -->
  <div class="mb-8 flex flex-wrap gap-3">
    <template x-for="tag in availableTags">
      <button
        @click="selectedTag = tag"
        x-bind:class="{
          'bg-gradient-to-r from-blue-500 to-cyan-500 text-white shadow-lg shadow-blue-500/50 scale-105': selectedTag === tag,
          'bg-slate-100 text-slate-700 hover:bg-slate-200 hover:shadow-md': selectedTag !== tag
        }"
        class="px-5 py-2.5 rounded-full font-medium transition-all duration-200 capitalize text-sm"
        x-text="tag"></button>
    </template>
  </div>

  <!-- Photo Grid - Masonry Layout -->
  <div class="columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-4 space-y-4">
    <template x-for="photo in filteredPhotos">
      <div
        @click="openLightbox(photo)"
        class="relative break-inside-avoid mb-4 overflow-hidden rounded-xl cursor-pointer group bg-slate-100 shadow-md hover:shadow-2xl transition-all duration-300"
      >
        <img
          x-intersect.margin.200px="loadImage($el, photo.id, photo.thumbnailSrc)"
          x-bind:data-photo-id="photo.id"
          x-bind:data-src="photo.thumbnailSrc"
          x-bind:alt="photo.alt"
          src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'%3E%3Crect width='400' height='300' fill='%23e2e8f0'/%3E%3C/svg%3E"
          class="w-full object-cover transition-transform duration-500 group-hover:scale-105"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4"
        >
          <p
            x-show="photo.title"
            x-text="photo.title"
            class="text-white font-semibold text-lg transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300"
          >
          </p>
          <div
            x-show="photo.tags && photo.tags.length > 0"
            class="flex flex-wrap gap-1.5 mt-2 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300 delay-75"
          >
            <template x-for="tag in photo.tags?.slice(0, 3) || []">
              <span
                class="inline-block bg-blue-500/80 backdrop-blur-sm rounded-full px-2 py-0.5 text-xs text-white capitalize"
                x-text="tag"></span>
            </template>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Lightbox -->
  <div
    x-show="lightboxOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="closeLightbox()"
    @keyup.escape.window="closeLightbox()"
    @keyup.arrow-left.window="lightboxOpen && prevPhoto()"
    @keyup.arrow-right.window="lightboxOpen && nextPhoto()"
    class="fixed inset-0 z-50 bg-black bg-opacity-95 flex items-center justify-center p-4"
    style="display: none;"
  >
    <!-- Download Button -->
    <a
      x-show="selectedPhoto"
      :href="selectedPhoto?.src"
      :download="selectedPhoto?.filename"
      @click.stop
      class="absolute top-4 right-16 text-white hover:text-blue-400 transition-colors z-10 bg-black/30 hover:bg-black/50 rounded-full p-2 backdrop-blur-sm"
      aria-label="Download photo"
      title="Download full size"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
        ></path>
      </svg>
    </a>

    <!-- Close Button -->
    <button
      @click.stop="closeLightbox()"
      class="absolute top-4 right-4 text-white hover:text-gray-300 transition-colors z-10"
      aria-label="Close lightbox"
    >
      <svg
        class="w-8 h-8"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <button
      @click.stop="prevPhoto()"
      class="absolute left-4 text-white hover:text-gray-300 transition-colors z-10"
      aria-label="Previous photo"
    >
      <svg
        class="w-10 h-10"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button
      @click.stop="nextPhoto()"
      class="absolute right-4 text-white hover:text-gray-300 transition-colors z-10"
      aria-label="Next photo"
    >
      <svg
        class="w-10 h-10"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div
      @click.stop
      class="relative max-w-5xl max-h-[90vh] flex flex-col items-center"
      x-show="selectedPhoto"
    >
      <img
        x-show="selectedPhoto"
        :src="selectedPhoto?.src"
        :alt="selectedPhoto?.alt"
        class="max-w-full max-h-[80vh] object-contain rounded-lg"
      />
      <div class="mt-4 text-white w-full max-w-3xl">
        <!-- Title and Caption -->
        <div class="text-center mb-4">
          <h3
            x-show="selectedPhoto?.title"
            x-text="selectedPhoto?.title"
            class="text-xl font-semibold"
          >
          </h3>
          <p
            x-show="selectedPhoto?.caption"
            x-text="selectedPhoto?.caption"
            class="mt-2 text-sm text-gray-300"
          >
          </p>
        </div>

        <!-- EXIF Metadata -->
        <div
          x-show="selectedPhoto?.exif && (selectedPhoto.exif.camera || selectedPhoto.exif.dateTime)"
          class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs bg-black/30 rounded-lg p-4"
        >
          <div x-show="selectedPhoto?.exif?.dateTime">
            <div class="text-gray-400">Date</div>
            <div x-text="selectedPhoto?.exif?.dateTime"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.camera">
            <div class="text-gray-400">Camera</div>
            <div x-text="selectedPhoto?.exif?.camera"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.lens">
            <div class="text-gray-400">Lens</div>
            <div x-text="selectedPhoto?.exif?.lens"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.focalLength">
            <div class="text-gray-400">Focal Length</div>
            <div x-text="selectedPhoto?.exif?.focalLength"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.aperture">
            <div class="text-gray-400">Aperture</div>
            <div x-text="selectedPhoto?.exif?.aperture"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.shutterSpeed">
            <div class="text-gray-400">Shutter</div>
            <div x-text="selectedPhoto?.exif?.shutterSpeed"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.iso">
            <div class="text-gray-400">ISO</div>
            <div x-text="selectedPhoto?.exif?.iso"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.location">
            <div class="text-gray-400">Location</div>
            <div x-text="selectedPhoto?.exif?.location"></div>
          </div>
        </div>

        <!-- Tags -->
        <div
          x-show="selectedPhoto?.tags && selectedPhoto.tags.length > 0"
          class="mt-4 text-center"
        >
          <template x-for="tag in selectedPhoto?.tags || []">
            <span
              class="inline-block bg-gray-700 rounded-full px-3 py-1 text-xs mr-2 capitalize"
              x-text="tag"></span>
          </template>
        </div>
      </div>
    </div>
  </div>

  <!-- Empty State -->
  <div
    x-show="filteredPhotos.length === 0"
    class="text-center py-12 text-gray-500"
  >
    <p class="text-xl">No photos found for this tag</p>
  </div>
</div>
