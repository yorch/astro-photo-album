---
import type { Photo } from "../types/album";

interface Props {
  photos: Photo[];
  albumId?: string;
}

const { photos, albumId } = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, ""); // Remove trailing slash

// Transform photos to include necessary fields for Alpine
const photosData = photos.map((photo, index) => ({
  alt: photo.title || photo.filename,
  caption: photo.caption,
  exif: photo.exif,
  filename: photo.filename,
  id: `${albumId || "photo"}-${index}`,
  lightboxSrc: `${base}${photo.lightboxUrl}`,
  src: `${base}${photo.url}`,
  tags: photo.tags,
  thumbnailSrc: `${base}${photo.thumbnailUrl}`,
  title: photo.title,
}));
---

<div
  x-data="{
    photos: [],
    selectedPhoto: null,
    lightboxOpen: false,
    selectedTag: 'all',
    availableTags: [],
    scrollDirection: 'down',
    lastScrollY: 0,
    layoutMode: $persist('masonry').as('photo-gallery-layout'),
    zoomLevel: 1,
    panX: 0,
    panY: 0,
    isDragging: false,
    dragStartX: 0,
    dragStartY: 0,

    init() {
      this.photos = JSON.parse(this.$el.dataset.photos);
      this.availableTags = this.extractTags();
      this.setupScrollTracking();
    },

    zoomIn() {
      if (this.zoomLevel === 1) {
        // Preload full-size image when first zooming in
        const fullImg = new Image();
        fullImg.src = this.selectedPhoto.src;
      }
      // Zoom in steps: 1 -> 1.5 -> 2 -> 2.5 -> 3
      if (this.zoomLevel < 3) {
        this.zoomLevel = Math.min(3, this.zoomLevel + 0.5);
      }
    },

    zoomOut() {
      // Zoom out steps: 3 -> 2.5 -> 2 -> 1.5 -> 1
      if (this.zoomLevel > 1) {
        this.zoomLevel = Math.max(1, this.zoomLevel - 0.5);
        if (this.zoomLevel === 1) {
          this.panX = 0;
          this.panY = 0;
        }
      }
    },

    resetZoom() {
      this.zoomLevel = 1;
      this.panX = 0;
      this.panY = 0;
    },

    startDrag(e) {
      if (this.zoomLevel <= 1) return;
      e.preventDefault();
      this.isDragging = true;
      this.dragStartX = e.clientX;
      this.dragStartY = e.clientY;
    },

    onDrag(e) {
      if (!this.isDragging || this.zoomLevel <= 1) return;
      e.preventDefault();
      const deltaX = (e.clientX - this.dragStartX) / this.zoomLevel;
      const deltaY = (e.clientY - this.dragStartY) / this.zoomLevel;

      // Calculate new pan values
      let newPanX = this.panX + deltaX;
      let newPanY = this.panY + deltaY;

      // Apply pan limits to prevent dragging too far
      // Pan limit is based on how much the zoomed image extends beyond viewport
      // At zoom level Z, the image extends (Z - 1) / 2 on each side
      // We allow panning the full extended area
      const maxPan = 300 * (this.zoomLevel - 1); // Maximum pan distance in pixels
      newPanX = Math.max(-maxPan, Math.min(maxPan, newPanX));
      newPanY = Math.max(-maxPan, Math.min(maxPan, newPanY));

      this.panX = newPanX;
      this.panY = newPanY;
      this.dragStartX = e.clientX;
      this.dragStartY = e.clientY;
    },

    stopDrag() {
      this.isDragging = false;
    },

    get layoutClasses() {
      const layouts = {
        masonry: 'columns-1 sm:columns-2 lg:columns-3 xl:columns-4 gap-4 space-y-4',
        grid: 'grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4',
        list: 'flex flex-col gap-4 max-w-4xl mx-auto'
      };
      return layouts[this.layoutMode] || layouts.masonry;
    },

    get photoCardClasses() {
      const cardClasses = {
        masonry: 'relative break-inside-avoid mb-4 overflow-hidden rounded-2xl cursor-pointer group bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-800 dark:to-slate-900 shadow-lg hover:shadow-2xl transition-all duration-500 hover:scale-[1.02] hover:-rotate-1 border border-slate-200/50 dark:border-slate-700/50',
        grid: 'relative overflow-hidden rounded-2xl cursor-pointer group bg-gradient-to-br from-slate-50 to-slate-100 dark:from-slate-800 dark:to-slate-900 shadow-lg hover:shadow-2xl transition-all duration-500 aspect-square hover:scale-105 border border-slate-200/50 dark:border-slate-700/50',
        list: 'relative overflow-hidden rounded-2xl cursor-pointer group bg-gradient-to-r from-slate-50 to-slate-100 dark:from-slate-800 dark:to-slate-900 shadow-lg hover:shadow-2xl transition-all duration-500 flex flex-row h-52 hover:scale-[1.01] border border-slate-200/50 dark:border-slate-700/50'
      };
      return cardClasses[this.layoutMode] || cardClasses.masonry;
    },

    get imageClasses() {
      const imgClasses = {
        masonry: 'w-full object-cover transition-transform duration-500 group-hover:scale-105',
        grid: 'w-full h-full object-cover transition-transform duration-500 group-hover:scale-105',
        list: 'w-1/3 h-full object-cover transition-transform duration-500 group-hover:scale-105'
      };
      return imgClasses[this.layoutMode] || imgClasses.masonry;
    },

    setupScrollTracking() {
      let scrollTimeout;
      window.addEventListener('scroll', () => {
        const currentScrollY = window.scrollY;
        this.scrollDirection = currentScrollY > this.lastScrollY ? 'down' : 'up';
        this.lastScrollY = currentScrollY;

        clearTimeout(scrollTimeout);
        scrollTimeout = setTimeout(() => {
          this.prefetchNearbyImages();
        }, 150);
      }, { passive: true });
    },

    loadImage(img, photoId, thumbnailSrc) {
      if (!img.dataset.loaded) {
        img.src = thumbnailSrc;
        img.dataset.loaded = 'true';

        // Prefetch nearby images after loading
        setTimeout(() => this.prefetchNearbyImages(), 50);
      }
    },

    prefetchNearbyImages() {
      // Prefetch images near the viewport
      const images = this.$el.querySelectorAll('img[data-photo-id]:not([data-loaded])');
      images.forEach(img => {
        const rect = img.getBoundingClientRect();
        const margin = this.scrollDirection === 'down' ? 600 : 400;
        const isNearViewport = rect.top < window.innerHeight + margin && rect.bottom > -200;

        if (isNearViewport && img.dataset.src) {
          img.src = img.dataset.src;
          img.dataset.loaded = 'true';
        }
      });
    },

    extractTags() {
      const tags = new Set(['all']);
      this.photos.forEach(photo => {
        if (photo.tags) {
          photo.tags.forEach(tag => tags.add(tag));
        }
      });
      return Array.from(tags);
    },

    get filteredPhotos() {
      const filtered = this.selectedTag === 'all'
        ? this.photos
        : this.photos.filter(photo => photo.tags && photo.tags.includes(this.selectedTag));

      // Trigger image loading after filter changes
      this.$nextTick(() => this.prefetchNearbyImages());

      return filtered;
    },

    openLightbox(photo) {
      this.selectedPhoto = photo;
      this.lightboxOpen = true;
      this.resetZoom();
      // Preload lightbox image when lightbox opens
      const lightboxImg = new Image();
      lightboxImg.src = photo.lightboxSrc;
    },

    closeLightbox() {
      this.lightboxOpen = false;
      this.resetZoom();
      setTimeout(() => this.selectedPhoto = null, 300);
    },

    nextPhoto() {
      const currentIndex = this.filteredPhotos.findIndex(p => p.id === this.selectedPhoto.id);
      const nextIndex = (currentIndex + 1) % this.filteredPhotos.length;
      this.selectedPhoto = this.filteredPhotos[nextIndex];
      this.resetZoom();
      // Preload next photo's lightbox image
      const nextNextIndex = (nextIndex + 1) % this.filteredPhotos.length;
      const preloadImg = new Image();
      preloadImg.src = this.filteredPhotos[nextNextIndex].lightboxSrc;
    },

    prevPhoto() {
      const currentIndex = this.filteredPhotos.findIndex(p => p.id === this.selectedPhoto.id);
      const prevIndex = (currentIndex - 1 + this.filteredPhotos.length) % this.filteredPhotos.length;
      this.selectedPhoto = this.filteredPhotos[prevIndex];
      this.resetZoom();
      // Preload previous photo's lightbox image
      const prevPrevIndex = (prevIndex - 1 + this.filteredPhotos.length) % this.filteredPhotos.length;
      const preloadImg = new Image();
      preloadImg.src = this.filteredPhotos[prevPrevIndex].lightboxSrc;
    }
  }"
  data-photos={JSON.stringify(photosData)}
  class="w-full"
>
  <!-- Controls: Tag Filter & Layout Switcher -->
  <div
    class="mb-8 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4"
  >
    <!-- Tag Filter -->
    <div class="flex flex-wrap gap-3">
      <template x-for="tag in availableTags">
        <button
          @click="selectedTag = tag"
          x-bind:class="{
            'bg-gradient-to-r from-purple-500 via-blue-500 to-cyan-500 text-white shadow-lg shadow-purple-500/30 scale-110 -rotate-1': selectedTag === tag,
            'bg-gradient-to-r from-slate-100 to-slate-50 dark:from-slate-700 dark:to-slate-800 text-slate-700 dark:text-slate-300 hover:bg-gradient-to-r hover:from-slate-200 hover:to-slate-100 dark:hover:from-slate-600 dark:hover:to-slate-700 hover:shadow-md hover:scale-105 border border-slate-200 dark:border-slate-600': selectedTag !== tag
          }"
          class="px-6 py-3 rounded-full font-bold transition-all duration-300 capitalize text-sm shadow-md"
          x-text="tag"></button>
      </template>
    </div>

    <!-- Layout Switcher -->
    <div
      class="flex gap-2 bg-gradient-to-r from-slate-100 to-slate-50 dark:from-slate-800 dark:to-slate-900 rounded-xl p-1.5 border-2 border-slate-200 dark:border-slate-700 shadow-md"
    >
      <button
        @click="layoutMode = 'masonry'"
        x-bind:class="{
          'bg-gradient-to-br from-purple-500 to-blue-500 text-white shadow-lg scale-110': layoutMode === 'masonry',
          'hover:bg-slate-200 dark:hover:bg-slate-700 hover:scale-105': layoutMode !== 'masonry'
        }"
        class="px-3 py-2 rounded-lg transition-all duration-300"
        title="Masonry layout"
        aria-label="Switch to masonry layout"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 5a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 16a1 1 0 011-1h4a1 1 0 011 1v3a1 1 0 01-1 1H5a1 1 0 01-1-1v-3zM14 12a1 1 0 011-1h4a1 1 0 011 1v7a1 1 0 01-1 1h-4a1 1 0 01-1-1v-7z"
          ></path>
        </svg>
      </button>
      <button
        @click="layoutMode = 'grid'"
        x-bind:class="{
          'bg-gradient-to-br from-purple-500 to-blue-500 text-white shadow-lg scale-110': layoutMode === 'grid',
          'hover:bg-slate-200 dark:hover:bg-slate-700 hover:scale-105': layoutMode !== 'grid'
        }"
        class="px-3 py-2 rounded-lg transition-all duration-300"
        title="Grid layout"
        aria-label="Switch to grid layout"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM14 5a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1V5zM4 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1H5a1 1 0 01-1-1v-4zM14 15a1 1 0 011-1h4a1 1 0 011 1v4a1 1 0 01-1 1h-4a1 1 0 01-1-1v-4z"
          ></path>
        </svg>
      </button>
      <button
        @click="layoutMode = 'list'"
        x-bind:class="{
          'bg-gradient-to-br from-purple-500 to-blue-500 text-white shadow-lg scale-110': layoutMode === 'list',
          'hover:bg-slate-200 dark:hover:bg-slate-700 hover:scale-105': layoutMode !== 'list'
        }"
        class="px-3 py-2 rounded-lg transition-all duration-300"
        title="List layout"
        aria-label="Switch to list layout"
      >
        <svg
          class="w-5 h-5"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </button>
    </div>
  </div>

  <!-- Photo Gallery - Dynamic Layout -->
  <div x-bind:class="layoutClasses">
    <template x-for="photo in filteredPhotos">
      <div @click="openLightbox(photo)" x-bind:class="photoCardClasses">
        <img
          x-intersect.margin.200px="loadImage($el, photo.id, photo.thumbnailSrc)"
          x-bind:data-photo-id="photo.id"
          x-bind:data-src="photo.thumbnailSrc"
          x-bind:alt="photo.alt"
          x-bind:class="imageClasses"
          src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 300'%3E%3Crect width='400' height='300' fill='%23e2e8f0'/%3E%3C/svg%3E"
        />
        <div
          x-bind:class="layoutMode === 'list' ? 'w-2/3 p-6 flex flex-col justify-center' : 'absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex flex-col justify-end p-4'"
        >
          <p
            x-show="photo.title"
            x-text="photo.title"
            x-bind:class="layoutMode === 'list' ? 'text-slate-900 dark:text-slate-100 font-semibold text-xl mb-2' : 'text-white font-semibold text-lg transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300'"
          >
          </p>
          <div
            x-show="photo.tags && photo.tags.length > 0"
            x-bind:class="layoutMode === 'list' ? 'flex flex-wrap gap-1.5' : 'flex flex-wrap gap-1.5 mt-2 transform translate-y-2 group-hover:translate-y-0 transition-transform duration-300 delay-75'"
          >
            <template x-for="tag in photo.tags?.slice(0, 3) || []">
              <span
                x-bind:class="layoutMode === 'list' ? 'inline-block bg-blue-500 rounded-full px-2 py-0.5 text-xs text-white capitalize' : 'inline-block bg-blue-500/80 backdrop-blur-sm rounded-full px-2 py-0.5 text-xs text-white capitalize'"
                x-text="tag"></span>
            </template>
          </div>
        </div>
      </div>
    </template>
  </div>

  <!-- Lightbox -->
  <div
    x-show="lightboxOpen"
    x-transition:enter="transition ease-out duration-300"
    x-transition:enter-start="opacity-0"
    x-transition:enter-end="opacity-100"
    x-transition:leave="transition ease-in duration-200"
    x-transition:leave-start="opacity-100"
    x-transition:leave-end="opacity-0"
    @click="closeLightbox()"
    @keyup.escape.window="closeLightbox()"
    @keyup.arrow-left.window="lightboxOpen && prevPhoto()"
    @keyup.arrow-right.window="lightboxOpen && nextPhoto()"
    class="fixed inset-0 z-50 bg-gradient-to-br from-slate-900/98 via-purple-900/95 to-blue-900/98 backdrop-blur-xl flex items-center justify-center p-4"
    style="display: none;"
  >
    <!-- Download Button -->
    <a
      x-show="selectedPhoto"
      :href="selectedPhoto?.src"
      :download="selectedPhoto?.filename"
      @click.stop
      class="absolute top-6 right-20 text-white hover:text-cyan-400 transition-all duration-300 z-10 bg-gradient-to-br from-purple-500/40 to-blue-500/40 hover:from-purple-500/60 hover:to-blue-500/60 rounded-full p-3 backdrop-blur-md shadow-lg hover:scale-110"
      aria-label="Download photo"
      title="Download full size"
    >
      <svg
        class="w-6 h-6"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"
        ></path>
      </svg>
    </a>

    <!-- Close Button -->
    <button
      @click.stop="closeLightbox()"
      class="absolute top-6 right-6 text-white hover:text-red-400 transition-all duration-300 z-10 bg-gradient-to-br from-slate-700/40 to-slate-800/40 hover:from-red-500/40 hover:to-red-600/40 rounded-full p-3 backdrop-blur-md shadow-lg hover:scale-110 hover:rotate-90"
      aria-label="Close lightbox"
    >
      <svg
        class="w-8 h-8"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>

    <button
      @click.stop="prevPhoto()"
      class="absolute left-6 text-white hover:text-purple-400 transition-all duration-300 z-10 bg-gradient-to-br from-slate-700/40 to-slate-800/40 hover:from-purple-500/60 hover:to-blue-500/60 rounded-full p-4 backdrop-blur-md shadow-lg hover:scale-125 hover:-translate-x-1"
      aria-label="Previous photo"
    >
      <svg
        class="w-10 h-10"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M15 19l-7-7 7-7"></path>
      </svg>
    </button>

    <button
      @click.stop="nextPhoto()"
      class="absolute right-6 text-white hover:text-cyan-400 transition-all duration-300 z-10 bg-gradient-to-br from-slate-700/40 to-slate-800/40 hover:from-purple-500/60 hover:to-blue-500/60 rounded-full p-4 backdrop-blur-md shadow-lg hover:scale-125 hover:translate-x-1"
      aria-label="Next photo"
    >
      <svg
        class="w-10 h-10"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M9 5l7 7-7 7"></path>
      </svg>
    </button>

    <div
      @click.stop
      class="relative max-w-5xl max-h-[90vh] flex flex-col items-center"
      x-show="selectedPhoto"
    >
      <div class="relative overflow-hidden rounded-lg">
        <img
          x-show="selectedPhoto"
          :src="zoomLevel > 1 ? selectedPhoto?.src : selectedPhoto?.lightboxSrc"
          :alt="selectedPhoto?.alt"
          class="max-w-full max-h-[80vh] object-contain rounded-lg select-none"
          :class="{
            'cursor-grab': zoomLevel > 1 && !isDragging,
            'cursor-grabbing': zoomLevel > 1 && isDragging,
            'transition-transform duration-300': !isDragging
          }"
          :style="zoomLevel > 1 ? `transform: translate(${panX}px, ${panY}px) scale(${zoomLevel})` : ''"
          @mousedown="startDrag($event)"
          @mousemove="onDrag($event)"
          @mouseup="stopDrag()"
          @mouseleave="stopDrag()"
        />
        <!-- Zoom controls -->
        <div class="absolute top-4 right-4 flex flex-col gap-2">
          <button
            @click.stop="zoomIn()"
            class="bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm rounded-full p-2 hover:bg-purple-100 dark:hover:bg-purple-900/50 transition-colors shadow-lg"
            :class="{ 'opacity-50 cursor-not-allowed': zoomLevel >= 3 }"
            :disabled="zoomLevel >= 3"
          >
            <svg
              class="w-5 h-5 text-purple-600 dark:text-purple-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v6m3-3H7"
              ></path>
            </svg>
          </button>
          <button
            @click.stop="zoomOut()"
            class="bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm rounded-full p-2 hover:bg-purple-100 dark:hover:bg-purple-900/50 transition-colors shadow-lg"
            :class="{ 'opacity-50 cursor-not-allowed': zoomLevel <= 1 }"
            :disabled="zoomLevel <= 1"
          >
            <svg
              class="w-5 h-5 text-purple-600 dark:text-purple-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"></path>
            </svg>
          </button>
        </div>
        <!-- Zoom level indicator -->
        <div
          x-show="zoomLevel > 1"
          class="absolute bottom-4 right-4 bg-white/90 dark:bg-slate-900/90 backdrop-blur-sm rounded-full px-3 py-1.5 text-xs font-semibold text-purple-600 dark:text-purple-400 pointer-events-none"
        >
          <span x-text="`${zoomLevel}x`"></span>
        </div>
      </div>
      <div class="mt-4 text-white w-full max-w-3xl">
        <!-- Title and Caption -->
        <div class="text-center mb-4">
          <h3
            x-show="selectedPhoto?.title"
            x-text="selectedPhoto?.title"
            class="text-3xl font-bold bg-gradient-to-r from-purple-300 via-blue-300 to-cyan-300 bg-clip-text text-transparent"
          >
          </h3>
          <p
            x-show="selectedPhoto?.caption"
            x-text="selectedPhoto?.caption"
            class="mt-3 text-base text-gray-200 leading-relaxed"
          >
          </p>
        </div>

        <!-- EXIF Metadata -->
        <div
          x-show="selectedPhoto?.exif && (selectedPhoto.exif.camera || selectedPhoto.exif.dateTime)"
          class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm bg-gradient-to-br from-slate-900/60 to-purple-900/40 backdrop-blur-md rounded-2xl p-6 border border-purple-500/20 shadow-xl"
        >
          <div x-show="selectedPhoto?.exif?.dateTime">
            <div
              class="text-purple-300 font-semibold text-xs uppercase tracking-wider mb-1"
            >
              Date
            </div>
            <div x-text="selectedPhoto?.exif?.dateTime"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.camera">
            <div
              class="text-blue-300 font-semibold text-xs uppercase tracking-wider mb-1"
            >
              Camera
            </div>
            <div x-text="selectedPhoto?.exif?.camera"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.lens">
            <div
              class="text-cyan-300 font-semibold text-xs uppercase tracking-wider mb-1"
            >
              Lens
            </div>
            <div x-text="selectedPhoto?.exif?.lens"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.focalLength">
            <div
              class="text-purple-300 font-semibold text-xs uppercase tracking-wider mb-1"
            >
              Focal Length
            </div>
            <div x-text="selectedPhoto?.exif?.focalLength"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.aperture">
            <div
              class="text-blue-300 font-semibold text-xs uppercase tracking-wider mb-1"
            >
              Aperture
            </div>
            <div x-text="selectedPhoto?.exif?.aperture"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.shutterSpeed">
            <div
              class="text-cyan-300 font-semibold text-xs uppercase tracking-wider mb-1"
            >
              Shutter Speed
            </div>
            <div x-text="selectedPhoto?.exif?.shutterSpeed"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.iso">
            <div
              class="text-purple-300 font-semibold text-xs uppercase tracking-wider mb-1"
            >
              ISO
            </div>
            <div x-text="selectedPhoto?.exif?.iso"></div>
          </div>
          <div x-show="selectedPhoto?.exif?.location">
            <div
              class="text-blue-300 font-semibold text-xs uppercase tracking-wider mb-1"
            >
              Location
            </div>
            <div x-text="selectedPhoto?.exif?.location"></div>
          </div>
        </div>

        <!-- Tags -->
        <div
          x-show="selectedPhoto?.tags && selectedPhoto.tags.length > 0"
          class="mt-6 text-center"
        >
          <div
            class="text-purple-300 font-semibold text-xs uppercase tracking-wider mb-3"
          >
            Tags
          </div>
          <div class="flex flex-wrap justify-center gap-2">
            <template x-for="tag in selectedPhoto?.tags || []">
              <span
                class="inline-block bg-gradient-to-r from-purple-500/30 via-blue-500/30 to-cyan-500/30 backdrop-blur-sm border border-purple-400/30 rounded-full px-4 py-2 text-sm font-medium capitalize hover:scale-110 hover:rotate-2 transition-all duration-300 shadow-lg"
                x-text="tag"></span>
            </template>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Empty State -->
  <div
    x-show="filteredPhotos.length === 0"
    class="text-center py-12 text-gray-500 dark:text-gray-400"
  >
    <p class="text-xl">No photos found for this tag</p>
  </div>
</div>
