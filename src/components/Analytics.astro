---

import siteConfigJson from "../config/site.json";
import type { SiteConfig } from "../types/config";

const siteConfig = siteConfigJson as SiteConfig;
const { analytics } = siteConfig;

// Build the script URL with extensions
// Extensions are appended to the filename: script.outbound-links.file-downloads.js
function buildScriptUrl(baseUrl: string): string {
  if (!baseUrl) return "";

  const extensions: string[] = [];
  if (analytics.enableOutboundLinks) extensions.push("outbound-links");
  if (analytics.enableFileDownloads) extensions.push("file-downloads");

  if (extensions.length === 0) return baseUrl;

  // Replace script.js with script.{extensions}.js
  return baseUrl.replace(/\/js\/script\.js$/, `/js/script.${extensions.join(".")}.js`);
}

const scriptUrl = buildScriptUrl(analytics.plausibleScriptUrl);
---

{
  analytics.plausibleScriptUrl && (
    <>
      <script
        is:inline
        defer
        data-domain={analytics.plausibleDomain || undefined}
        src={scriptUrl}
      />
      <script is:inline>
        window.plausible = window.plausible || function() {
          (window.plausible.q = window.plausible.q || []).push(arguments);
        };
      </script>
    </>
  )
}
