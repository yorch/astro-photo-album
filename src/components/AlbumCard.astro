---
interface Props {
  id: string;
  title: string;
  description: string | null;
  coverPhoto: string | null;
  photoCount: number;
}

const { id, title, description, coverPhoto, photoCount } = Astro.props;
---

<a href={`/album/${id}`} class="album-card group">
  <div class="aspect-square overflow-hidden rounded-lg bg-gray-200">
    {
      coverPhoto ? (
        <img
          src={coverPhoto}
          alt={title}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center text-gray-400">
          <svg
            class="w-20 h-20"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
        </div>
      )
    }
  </div>
  <div class="mt-4">
    <h3
      class="text-lg font-semibold text-gray-900 group-hover:text-blue-600 transition-colors"
    >
      {title}
    </h3>
    {
      description && (
        <p class="mt-1 text-sm text-gray-600 line-clamp-2">{description}</p>
      )
    }
    <p class="mt-2 text-sm text-gray-500">
      {photoCount}
      {photoCount === 1 ? "photo" : "photos"}
    </p>
  </div>
</a>
