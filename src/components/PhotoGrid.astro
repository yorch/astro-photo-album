---
import type { Photo } from "../types/album";

interface Props {
  photos: Photo[];
  albumId: string;
}

const { photos, albumId } = Astro.props;
---

<div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
  {
    photos.map((photo, index) => (
      <button
        type="button"
        class="photo-thumbnail group relative aspect-square overflow-hidden rounded-lg bg-gray-200 cursor-pointer"
        data-photo-index={index}
        data-album-id={albumId}
      >
        <img
          src={photo.url}
          alt={photo.title || photo.filename}
          class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-black bg-opacity-0 group-hover:bg-opacity-30 transition-opacity flex items-center justify-center">
          <svg
            class="w-12 h-12 text-white opacity-0 group-hover:opacity-100 transition-opacity"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"
            />
          </svg>
        </div>
      </button>
    ))
  }
</div>

<script is:inline define:vars={{ photos }}>
  // Store photos data for lightbox access
  window.albumPhotos = photos;
</script>
