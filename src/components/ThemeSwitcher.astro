---
// Theme Switcher Component
---

<div
  x-data="{
    themes: ['light', 'dark', 'auto'],
    getThemeIcon(theme) {
      const icons = {
        light: 'M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z',
        dark: 'M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z',
        auto: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z'
      };
      return icons[theme];
    },
    getThemeLabel(theme) {
      const labels = { light: 'Light', dark: 'Dark', auto: 'Auto' };
      return labels[theme];
    }
  }"
  class="fixed bottom-4 right-4 z-50"
>
  <div
    class="flex gap-1 bg-white dark:bg-slate-800 rounded-lg p-0.5 shadow-md border border-slate-200 dark:border-slate-700"
  >
    <template x-for="themeOption in themes" :key="themeOption">
      <button
        @click="
          if (theme !== themeOption && window.plausible) {
            window.plausible('Theme Switch', { props: { from: theme, to: themeOption } });
          }
          theme = themeOption;
        "
        x-bind:class="{
          'bg-gradient-to-r from-blue-500 to-cyan-500 text-white shadow-sm': theme === themeOption,
          'text-slate-600 dark:text-slate-300 hover:bg-slate-100 dark:hover:bg-slate-700': theme !== themeOption
        }"
        class="p-1.5 rounded-md transition-all duration-200"
        x-bind:title="getThemeLabel(themeOption)"
        x-bind:aria-label="`Switch to ${getThemeLabel(themeOption)} theme`"
      >
        <svg
          class="w-4 h-4"
          fill="none"
          stroke="currentColor"
          viewBox="0 0 24 24"
          x-bind:d="getThemeIcon(themeOption)"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            x-bind:d="getThemeIcon(themeOption)"></path>
        </svg>
      </button>
    </template>
  </div>
</div>
