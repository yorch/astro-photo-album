---
import PhotoGallery from "../../components/PhotoGallery.astro";
import albumDataJson from "../../data/albums.json";
import Layout from "../../layouts/Layout.astro";
import type { Album, AlbumData } from "../../types/album";

export function getStaticPaths() {
  const albumData = albumDataJson as AlbumData;
  const { albums } = albumData;
  return albums.map((album) => ({
    params: { id: album.id },
    props: { album },
  }));
}

interface Props {
  album: Album;
}

const { album } = Astro.props;
---

<Layout>
  <div
    class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50/30 to-cyan-50/20 dark:from-slate-900 dark:via-blue-950/30 dark:to-cyan-950/20"
  >
    <!-- Header with back button -->
    <header
      class="bg-white/80 dark:bg-slate-800/80 backdrop-blur-md border-b border-slate-200/60 dark:border-slate-700/60 sticky top-0 z-40 shadow-sm"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6">
        <div class="flex items-center justify-between">
          <a
            href="/"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-100 dark:bg-slate-700 hover:bg-gradient-to-r hover:from-blue-500 hover:to-cyan-500 text-slate-700 dark:text-slate-300 hover:text-white transition-all duration-200 group"
          >
            <svg
              class="w-5 h-5 transition-transform group-hover:-translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
            </svg>
            <span class="font-medium">Albums</span>
          </a>
          <div
            class="flex items-center gap-3 text-sm text-slate-600 dark:text-slate-400"
          >
            <div
              class="flex items-center gap-1.5 px-3 py-1.5 bg-blue-50 dark:bg-blue-900/30 rounded-full"
            >
              <svg
                class="w-4 h-4 text-blue-600"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
                ></path>
              </svg>
              <span class="font-medium text-blue-700 dark:text-blue-300">
                {album.photoCount}
                {album.photoCount === 1 ? "photo" : "photos"}
              </span>
            </div>
          </div>
        </div>
        <div class="mt-6">
          <h1
            class="text-4xl font-bold bg-gradient-to-r from-slate-900 via-blue-900 to-cyan-900 dark:from-slate-100 dark:via-blue-100 dark:to-cyan-100 bg-clip-text text-transparent"
          >
            {album.title}
          </h1>
          {
            album.description && (
              <p class="mt-3 text-lg text-slate-600 dark:text-slate-400 max-w-3xl">
                {album.description}
              </p>
            )
          }
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {
        album.photos.length === 0 ? (
          <div class="text-center py-12">
            <svg
              class="mx-auto h-24 w-24 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            <h3 class="mt-4 text-lg font-medium text-gray-900 dark:text-gray-100">
              No photos in this album
            </h3>
            <p class="mt-2 text-gray-600 dark:text-gray-400">
              Add photos to{" "}
              <code class="bg-gray-100 dark:bg-gray-800 px-2 py-1 rounded">
                public/albums/{album.id}/
              </code>
            </p>
          </div>
        ) : (
          <PhotoGallery photos={album.photos} albumId={album.id} />
        )
      }
    </main>
  </div>
</Layout>
