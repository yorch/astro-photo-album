---
import Lightbox from "../../components/Lightbox.astro";
import PhotoGrid from "../../components/PhotoGrid.astro";
import albumDataJson from "../../data/albums.json";
import Layout from "../../layouts/Layout.astro";
import type { Album, AlbumData } from "../../types/album";

export function getStaticPaths() {
  const albumData = albumDataJson as AlbumData;
  const { albums } = albumData;
  return albums.map((album) => ({
    params: { id: album.id },
    props: { album },
  }));
}

interface Props {
  album: Album;
}

const { album } = Astro.props;
---

<Layout>
  <div class="min-h-screen bg-gray-50">
    <!-- Header with back button -->
    <header class="bg-white shadow-sm sticky top-0 z-40">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <div class="flex items-center gap-4">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-gray-600 hover:text-gray-900 transition-colors"
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M15 19l-7-7 7-7"></path>
            </svg>
            Back to Albums
          </a>
        </div>
        <div class="mt-4">
          <h1 class="text-3xl font-bold text-gray-900">{album.title}</h1>
          {
            album.description && (
              <p class="mt-2 text-gray-600">{album.description}</p>
            )
          }
          <p class="mt-2 text-sm text-gray-500">
            {album.photoCount}
            {album.photoCount === 1 ? "photo" : "photos"}
          </p>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {
        album.photos.length === 0 ? (
          <div class="text-center py-12">
            <svg
              class="mx-auto h-24 w-24 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            <h3 class="mt-4 text-lg font-medium text-gray-900">
              No photos in this album
            </h3>
            <p class="mt-2 text-gray-600">
              Add photos to{" "}
              <code class="bg-gray-100 px-2 py-1 rounded">
                public/albums/{album.id}/
              </code>
            </p>
          </div>
        ) : (
          <PhotoGrid photos={album.photos} albumId={album.id} />
        )
      }
    </main>
  </div>

  <!-- Lightbox component -->
  <Lightbox />
</Layout>
