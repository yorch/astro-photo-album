---
import PhotoCard from "../components/PhotoCard.astro";
import PhotoGallery from "../components/PhotoGallery.astro";
import Layout from "../layouts/Layout.astro";
import type { Photo } from "../types/album";

// Helper to create demo photo objects
const createDemoPhoto = (
  filename: string,
  url: string,
  title: string,
  tags: string[]
): Photo => ({
  caption: null,
  exif: {
    aperture: null,
    camera: null,
    dateTime: null,
    focalLength: null,
    height: null,
    iso: null,
    lens: null,
    location: null,
    shutterSpeed: null,
    width: null,
  },
  filename,
  fileSize: 0,
  tags,
  title,
  url,
});

// Sample photos for demonstration
const samplePhotos: Photo[] = [
  createDemoPhoto(
    "mountain-peak.jpg",
    "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?w=800",
    "Mountain Peak",
    ["nature", "landscape", "mountains"]
  ),
  createDemoPhoto(
    "forest-trail.jpg",
    "https://images.unsplash.com/photo-1472214103451-9374bd1c798e?w=800",
    "Forest Trail",
    ["nature", "forest", "landscape"]
  ),
  createDemoPhoto(
    "coastal-sunset.jpg",
    "https://images.unsplash.com/photo-1501594907352-04cda38ebc29?w=800",
    "Coastal Sunset",
    ["beach", "sunset", "ocean"]
  ),
  createDemoPhoto(
    "alpine-lake.jpg",
    "https://images.unsplash.com/photo-1469474968028-56623f02e42e?w=800",
    "Alpine Lake",
    ["nature", "lake", "mountains"]
  ),
  createDemoPhoto(
    "spring-meadow.jpg",
    "https://images.unsplash.com/photo-1447752875215-b2761acb3c5d?w=800",
    "Spring Meadow",
    ["nature", "flowers", "landscape"]
  ),
  createDemoPhoto(
    "misty-peaks.jpg",
    "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?w=800",
    "Misty Peaks",
    ["nature", "mountains", "landscape"]
  ),
  createDemoPhoto(
    "woodland-canopy.jpg",
    "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?w=800",
    "Woodland Canopy",
    ["nature", "forest"]
  ),
  createDemoPhoto(
    "desert-vista.jpg",
    "https://images.unsplash.com/photo-1433086966358-54859d0ed716?w=800",
    "Desert Vista",
    ["landscape", "desert"]
  ),
];
---

<Layout>
  <main class="min-h-screen bg-gray-50 py-12">
    <div class="max-w-7xl mx-auto px-4">
      <!-- Header -->
      <header class="mb-12 text-center">
        <h1 class="text-4xl font-bold text-gray-900 mb-4">
          Photo Gallery Demo
        </h1>
        <p class="text-lg text-gray-600">
          Interactive photo gallery powered by Alpine.js
        </p>
      </header>

      <!-- PhotoGallery Component Demo -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">
          Full Gallery Component
        </h2>
        <div class="bg-white rounded-xl shadow-lg p-6">
          <PhotoGallery photos={samplePhotos} />
        </div>
      </section>

      <!-- PhotoCard Component Demo -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">
          Individual Photo Cards
        </h2>
        <div
          class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4"
        >
          {
            samplePhotos
              .slice(0, 4)
              .map((photo) => (
                <PhotoCard
                  src={photo.url}
                  alt={photo.title || photo.filename}
                  title={photo.title || undefined}
                  description={photo.tags?.join(", ")}
                />
              ))
          }
        </div>
      </section>

      <!-- Alpine.js Features Demo -->
      <section class="mb-16">
        <h2 class="text-2xl font-bold text-gray-900 mb-6">
          Alpine.js Features
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Counter Example -->
          <div class="bg-white rounded-xl shadow-lg p-6">
            <h3 class="text-xl font-semibold mb-4">Reactive Counter</h3>
            <div x-data="{ count: 0 }" class="space-y-4">
              <div class="text-center">
                <p class="text-6xl font-bold text-blue-600" x-text="count"></p>
                <p class="text-gray-600 mt-2">Current Count</p>
              </div>
              <div class="flex gap-2 justify-center">
                <button
                  @click="count--"
                  class="px-4 py-2 bg-red-500 text-white rounded-lg hover:bg-red-600 transition-colors"
                >
                  Decrement
                </button>
                <button
                  @click="count = 0"
                  class="px-4 py-2 bg-gray-500 text-white rounded-lg hover:bg-gray-600 transition-colors"
                >
                  Reset
                </button>
                <button
                  @click="count++"
                  class="px-4 py-2 bg-green-500 text-white rounded-lg hover:bg-green-600 transition-colors"
                >
                  Increment
                </button>
              </div>
            </div>
          </div>

          <!-- Dropdown Example -->
          <div class="bg-white rounded-xl shadow-lg p-6">
            <h3 class="text-xl font-semibold mb-4">Dropdown Toggle</h3>
            <div x-data="{ open: false }">
              <button
                @click="open = !open"
                class="w-full px-4 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors"
              >
                <span x-text="open ? 'Close' : 'Open'"></span> Dropdown
              </button>
              <div
                x-show="open"
                @click.outside="open = false"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0 transform scale-95"
                x-transition:enter-end="opacity-100 transform scale-100"
                x-transition:leave="transition ease-in duration-150"
                x-transition:leave-start="opacity-100 transform scale-100"
                x-transition:leave-end="opacity-0 transform scale-95"
                class="mt-4 p-4 bg-gray-100 rounded-lg"
                style="display: none;"
              >
                <p class="text-gray-700">
                  This content appears with a smooth transition! Click outside
                  to close.
                </p>
              </div>
            </div>
          </div>

          <!-- Tabs Example -->
          <div class="bg-white rounded-xl shadow-lg p-6 md:col-span-2">
            <h3 class="text-xl font-semibold mb-4">Tab Navigation</h3>
            <div x-data="{ activeTab: 'gallery' }">
              <div class="flex gap-2 mb-4">
                <button
                  @click="activeTab = 'gallery'"
                  :class="activeTab === 'gallery' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-800'"
                  class="px-4 py-2 rounded-lg transition-colors font-medium"
                >
                  Gallery
                </button>
                <button
                  @click="activeTab = 'favorites'"
                  :class="activeTab === 'favorites' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-800'"
                  class="px-4 py-2 rounded-lg transition-colors font-medium"
                >
                  Favorites
                </button>
                <button
                  @click="activeTab = 'settings'"
                  :class="activeTab === 'settings' ? 'bg-blue-600 text-white' : 'bg-gray-200 text-gray-800'"
                  class="px-4 py-2 rounded-lg transition-colors font-medium"
                >
                  Settings
                </button>
              </div>
              <div class="p-4 bg-gray-50 rounded-lg">
                <div x-show="activeTab === 'gallery'">
                  <p class="text-gray-700">
                    Gallery tab content - Browse all your photos here.
                  </p>
                </div>
                <div x-show="activeTab === 'favorites'" style="display: none;">
                  <p class="text-gray-700">
                    Favorites tab content - View your liked photos.
                  </p>
                </div>
                <div x-show="activeTab === 'settings'" style="display: none;">
                  <p class="text-gray-700">
                    Settings tab content - Customize your experience.
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Documentation Link -->
      <section class="text-center">
        <p class="text-gray-600">
          Check out <a
            href="/ALPINE.md"
            class="text-blue-600 hover:underline font-medium">ALPINE.md</a
          > for detailed documentation
        </p>
      </section>
    </div>
  </main>
</Layout>
