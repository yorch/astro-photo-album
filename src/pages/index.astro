---
import AlbumCard from "../components/AlbumCard.astro";
import albumDataJson from "../data/albums.json";
import Layout from "../layouts/Layout.astro";
import type { AlbumData } from "../types/album";

const albumData = albumDataJson as AlbumData;
const { albums } = albumData;
---

<Layout>
  <div
    class="min-h-screen bg-gradient-to-br from-slate-50 via-blue-50/30 to-cyan-50/20"
  >
    <!-- Header -->
    <header
      class="bg-white/80 backdrop-blur-md border-b border-slate-200/60 shadow-sm"
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="text-center">
          <h1
            class="text-5xl font-bold bg-gradient-to-r from-slate-900 via-blue-900 to-cyan-900 bg-clip-text text-transparent"
          >
            Photo Albums
          </h1>
          <p class="mt-4 text-lg text-slate-600">
            Browse through {albums.length}
            {albums.length === 1 ? "collection" : "collections"}
          </p>
        </div>
      </div>
    </header>

    <!-- Main content -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      {
        albums.length === 0 ? (
          <div class="text-center py-12">
            <svg
              class="mx-auto h-24 w-24 text-gray-400"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"
              />
            </svg>
            <h3 class="mt-4 text-lg font-medium text-gray-900">
              No albums yet
            </h3>
            <p class="mt-2 text-gray-600">
              Add photos to the{" "}
              <code class="bg-gray-100 px-2 py-1 rounded">public/albums/</code>{" "}
              directory
            </p>
            <p class="mt-2 text-sm text-gray-500">
              See{" "}
              <code class="bg-gray-100 px-2 py-1 rounded">
                public/albums/README.md
              </code>{" "}
              for instructions
            </p>
          </div>
        ) : (
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
            {albums.map((album) => (
              <AlbumCard
                id={album.id}
                title={album.title}
                description={album.description}
                coverPhoto={album.coverPhoto}
                coverPhotoThumbnail={album.coverPhotoThumbnail}
                photoCount={album.photoCount}
              />
            ))}
          </div>
        )
      }
    </main>
  </div>
</Layout>
